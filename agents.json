{
  "schemaVersion": "1.1.0",
  "systemName": "Agentic Life OS (ALOS)",
  "version": "1.3.0",
  "runtime": {
    "mode": "local-open-core",
    "authority": "private-instance-control-plane",
    "defaultAdmission": "deny"
  },
  "modules": [
    {
      "key": "health",
      "repo": "agentic-health-os",
      "path": "packages/health",
      "status": "experimental",
      "risk": "sensitive-local",
      "verify": "pnpm --filter @frankx-ai/agentic-health-os test"
    },
    {
      "key": "memory",
      "repo": "second-brain-os",
      "path": "packages/memory",
      "status": "experimental",
      "risk": "private"
    },
    {
      "key": "orchestration",
      "repo": "agentic-orchestration-os",
      "path": "packages/orchestration",
      "status": "experimental",
      "risk": "bounded-runtime"
    },
    {
      "key": "family",
      "repo": "agentic-family-os",
      "path": "packages/family",
      "status": "experimental",
      "risk": "sensitive-local",
      "verify": "pnpm exec vitest run packages/family/tests",
      "purpose": "Evidence-backed private family research, human-governed relationship claims, audience-scoped ancestor projections, preservation, and stewardship."
    }
  ],
  "healthKnowledgeSource": {
    "repository": "frankxai/health-intelligence-system",
    "requiredBindings": ["commitSha", "artifactVersion", "artifactPath", "byteLength", "sha256"]
  },
  "prohibitedPublicData": [
    "raw-health-records",
    "clinical-data",
    "genomic-data",
    "family-records",
    "secrets",
    "authority-state",
    "personal-metrics"
  ]
}
