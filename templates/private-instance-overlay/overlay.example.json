{
  "schemaVersion": "1.0.0",
  "instanceId": "private-life-instance",
  "publicRuntime": {
    "repository": "frankxai/agentic-life-os",
    "version": "0.3.0"
  },
  "health": {
    "publicKnowledgeSource": {
      "repository": "frankxai/health-intelligence-system",
      "artifactVersion": "0.2.1",
      "requireImmutableCommit": true,
      "requireSha256Receipt": true
    },
    "vault": {
      "adapter": "separately-encrypted-local-vault",
      "rootFromEnvironment": "LIFE_OS_HEALTH_VAULT_ROOT"
    },
    "secondBrainProjection": {
      "enabled": false,
      "direction": "health-vault-to-second-brain-only",
      "maximumSensitivity": "personal",
      "requiresHumanApproval": true
    },
    "exports": {
      "transportEnabled": false,
      "requiresHumanApproval": true
    }
  },
  "trackedDataPolicy": {
    "allowSyntheticFixturesOnly": true,
    "excludeRawRecords": true,
    "excludeSecrets": true,
    "excludeAuthorityState": true
  }
}
