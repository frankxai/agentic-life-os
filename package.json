{
  "name": "@frankx-ai/agentic-life-os",
  "version": "0.3.0",
  "private": true,
  "description": "Open-source, local-first agent runtime with private-instance overlays and sovereign health-data boundaries.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "check:public": "node scripts/check-public-safety.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm -r build && node scripts/generate-alos-assets.mjs",
    "health": "node scripts/alos-health.mjs"
  },
  "devDependencies": {
    "typescript": "5.6.2",
    "vitest": "2.1.1",
    "@types/node": "24.0.0"
  }
}
